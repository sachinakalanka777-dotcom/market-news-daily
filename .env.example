# Required for AI summaries (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=put_your_gemini_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: backup AI. If absent, Gemini is tried and then publisher snippets are used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Unsplash image search (get Access Key from https://unsplash.com/developers)
UNSPLASH_API_KEY=

MAX_STORIES=15
LOOKBACK_HOURS=48
LOG_LEVEL=INFO
